{
  "name": "@reel/api",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "dev": "pnpm --filter @reel/db db:deploy && nest start --watch",
    "build": "nest build",
    "start": "node dist/main.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint \"src/**/*.ts\"",
    "test": "node --test test/canvas-agent.test.cjs test/canvas-agent-plan.test.cjs",
    "test:generation": "node --test test/generation-reliability.test.cjs",
    "test:agent": "node --test test/canvas-agent.test.cjs test/canvas-agent-plan.test.cjs",
    "test:agent:live": "LIVE_AGENT_SMOKE=1 node --env-file=.env --test --test-name-pattern=\"live HTTP chat persists\" test/canvas-agent.test.cjs",
    "test:agent:db": "AGENT_DATABASE_TESTS=1 node --env-file=.env --test test/canvas-agent-plan.test.cjs",
    "test:agent:plan:live": "LIVE_AGENT_SMOKE=1 node --env-file=.env --test --test-name-pattern=\"live Plan\" test/canvas-agent-plan.test.cjs",
    "test:agent:images:live": "LIVE_AGENT_SMOKE=1 node --env-file=.env --test --test-name-pattern=\"live phase two\" test/canvas-agent-plan.test.cjs"
  },
  "dependencies": {
    "@ffmpeg-installer/ffmpeg": "^1.1.0",
    "@ffprobe-installer/ffprobe": "^2.1.2",
    "@langchain/core": "^1.3.5",
    "@langchain/langgraph": "^1.7.1",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@nestjs/bullmq": "^11.0.1",
    "@nestjs/common": "^11.0.1",
    "@nestjs/config": "^4.0.0",
    "@nestjs/core": "^11.0.1",
    "@nestjs/platform-express": "^11.0.1",
    "@nestjs/serve-static": "^5.0.5",
    "@reel/ai-gen": "workspace:*",
    "@reel/contracts": "workspace:*",
    "@reel/db": "workspace:*",
    "@reel/llm": "workspace:*",
    "bullmq": "^5.34.6",
    "ffmpeg-static": "^5.3.0",
    "fluent-ffmpeg": "^2.1.3",
    "image-size": "^2.0.4",
    "multer": "^2.2.0",
    "nestjs-zod": "^4.2.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.0",
    "@types/fluent-ffmpeg": "^2.1.28",
    "@types/multer": "^2.1.0",
    "@types/node": "^20.17.12",
    "typescript": "^5.7.3"
  }
}
