# 应用端口
PORT=3888

# PostgreSQL（Prisma）—— 宿主机端口 5433（避开本机已占用的 5432）
DATABASE_URL="postgresql://postgres:postgres@localhost:5433/reel_mind?schema=public"

# Redis（BullMQ）—— 宿主机端口 6380（避开本机已占用的 6379）
REDIS_HOST=localhost
REDIS_PORT=6380

# 本地文件存储（上传素材）
STORAGE_DIR=storage
PUBLIC_URL=http://localhost:3888

# AI（智谱 API）—— 从 https://open.bigmodel.cn/usercenter/apikeys 获取 API Key
# 一个 Key 可用于文本/图像/视频生成
GLM_API_KEY=your-api-key-here
GLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
GLM_MODEL=glm-4-flash
GLM_IMAGE_MODEL=cogview-3-flash
GLM_VIDEO_MODEL=cogvideox-flash
