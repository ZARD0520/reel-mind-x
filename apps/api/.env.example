# 应用端口
PORT=3888

# PostgreSQL（Prisma）—— 宿主机端口 5433（避开本机已占用的 5432）
DATABASE_URL="postgresql://postgres:postgres@localhost:5433/reel_mind?schema=public"

# Redis（BullMQ）—— 宿主机端口 6380（避开本机已占用的 6379）
REDIS_HOST=localhost
REDIS_PORT=6380

# 本地文件存储（上传素材）
STORAGE_DIR=storage
PUBLIC_URL=http://localhost:3888
SESSION_SECRET=replace-with-a-random-secret-at-least-16-characters

# Add your Zhipu GLM API key to apps/api/.env before using AI features.
GLM_API_KEY=your-api-key-here
GLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
GLM_MODEL=glm-4-flash
GLM_IMAGE_MODEL=cogview-3-flash
GLM_VIDEO_MODEL=cogvideox-flash

# SiliconFlow Kolors image generation
SILICONFLOW_API_KEY=
SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1
SILICONFLOW_ASR_MODEL=XingChenAGI/XingChenASR-V3.2-Ultra
