# 线上访问地址。如果用域名, 改成 https://your-domain.com
PUBLIC_URL=http://your-server-ip:8080
CORS_ORIGIN=http://your-server-ip:8080

# 宿主机公开端口。避开已占用的 3000/3001。
WEB_PORT=8080

# 数据库只在 Docker 内网访问, 不会占用宿主机端口。
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-this-password
POSTGRES_DB=reel_mind

# 登录会话密钥, 至少 16 位。线上务必换成随机长字符串。
SESSION_SECRET=change-this-session-secret-at-least-16-chars
AUTH_COOKIE_NAME=reel_session
AUTH_SESSION_DAYS=7

# 智谱 API Key
GLM_API_KEY=your-api-key-here
GLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
GLM_MODEL=glm-4-flash
GLM_IMAGE_MODEL=cogview-3-flash
GLM_VIDEO_MODEL=cogvideox-flash
