generator client {
  provider = "prisma-client-js"
  output   = "../generated/client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String?
  name         String
  avatarUrl    String?
  status       String   @default("active")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  projects   Project[]
  canvases   Canvas[]
  assets     Asset[]
  renderJobs RenderJob[]

  @@map("users")
}

model Canvas {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  graph     Json     @default("{\"version\":1,\"nodes\":[],\"edges\":[],\"viewport\":{\"x\":0,\"y\":0,\"zoom\":1}}")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  assets Asset[]

  @@index([userId, updatedAt])
  @@map("canvases")
}

model Project {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  timeline  Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deletedAt DateTime?

  assets Asset[]

  @@index([userId, updatedAt])
  @@map("projects")
}

model Asset {
  id               String   @id @default(uuid())
  userId           String
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  projectId        String?
  project          Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)
  canvasId         String?
  canvas           Canvas?  @relation(fields: [canvasId], references: [id], onDelete: Cascade)
  kind             String
  source           String
  status           String
  name             String
  url              String?
  localPath        String?
  durationInFrames Int?
  width            Int?
  height           Int?
  prompt           String?
  createdAt        DateTime @default(now())

  @@index([userId, projectId, createdAt])
  @@index([userId, canvasId, createdAt])
  @@map("assets")
}

model RenderJob {
  id         String   @id @default(uuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  projectId  String
  status     String
  progress   Int      @default(0)
  outputUrl  String?
  outputPath String?
  fileName   String?
  error      String?
  createdAt  DateTime @default(now())

  @@index([userId, createdAt])
  @@map("render_jobs")
}
