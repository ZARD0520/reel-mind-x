generator client {
  provider = "prisma-client-js"
  output   = "../generated/client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String?
  name         String
  avatarUrl    String?
  status       String   @default("active")
  role         String   @default("user")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  projects     Project[]
  canvases     Canvas[]
  assets       Asset[]
  renderJobs   RenderJob[]
  assetFolders AssetFolder[]
  conversations CanvasConversation[]
  generationTasks GenerationTask[]
  creditAccount CreditAccount?
  creditEntries CreditEntry[]
  creditHolds CreditHold[]

  @@map("users")
}

model Canvas {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  graph     Json     @default("{\"version\":1,\"nodes\":[],\"edges\":[],\"viewport\":{\"x\":0,\"y\":0,\"zoom\":1}}")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  assets Asset[]
  conversations CanvasConversation[]
  generationTasks GenerationTask[]

  @@index([userId, updatedAt])
  @@map("canvases")
}

model Project {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  timeline  Json
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  assets Asset[]
  generationTasks GenerationTask[]

  @@index([userId, updatedAt])
  @@map("projects")
}

model CanvasConversation {
  id        String   @id @default(uuid())
  canvasId  String
  canvas    Canvas   @relation(fields: [canvasId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String   @default("新对话")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  messages  CanvasChatMessage[]

  @@index([canvasId, updatedAt])
  @@index([userId, updatedAt])
  @@map("canvas_conversations")
}

model CanvasChatMessage {
  id             String             @id @default(uuid())
  conversationId String
  conversation   CanvasConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  role           String
  content        String             @db.Text
  references     Json               @default("[]")
  createdAt      DateTime           @default(now())

  @@index([conversationId, createdAt])
  @@map("canvas_chat_messages")
}

model Asset {
  id               String       @id @default(uuid())
  userId           String
  user             User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  projectId        String?
  project          Project?     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  canvasId         String?
  canvas           Canvas?      @relation(fields: [canvasId], references: [id], onDelete: Cascade)
  // 素材库归属：folderId 非空表示素材库素材（projectId/canvasId 为空）
  folderId         String?
  folder           AssetFolder? @relation(fields: [folderId], references: [id], onDelete: Cascade)
  kind             String
  source           String
  status           String
  error            String?
  name             String
  url              String?
  localPath        String?
  // kind=text 时的文本内容；媒体素材为空
  content          String?
  durationInFrames Int?
  width            Int?
  height           Int?
  prompt           String?
  model            String?
  references       Json         @default("[]")
  historyDeletedAt DateTime?
  generationItem   GenerationTaskItem?
  createdAt        DateTime     @default(now())

  @@index([userId, projectId, createdAt])
  @@index([userId, canvasId, createdAt])
  @@index([userId, folderId, createdAt])
  @@map("assets")
}

model GenerationTask {
  id            String   @id @default(uuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  canvasId      String?
  canvas        Canvas?  @relation(fields: [canvasId], references: [id], onDelete: SetNull)
  projectId     String?
  project       Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  nodeId        String?
  requestId     String
  inputHash     String
  activeNodeKey String?  @unique
  kind          String
  model         String
  input         Json
  creditQuote   Json?
  status        String   @default("queued")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  items         GenerationTaskItem[]

  @@unique([userId, requestId])
  @@index([userId, canvasId, createdAt])
  @@index([status, updatedAt])
  @@map("generation_tasks")
}

model GenerationTaskItem {
  id               String   @id @default(uuid())
  taskId           String
  task             GenerationTask @relation(fields: [taskId], references: [id], onDelete: Cascade)
  index            Int
  assetId          String?  @unique
  asset            Asset?   @relation(fields: [assetId], references: [id], onDelete: SetNull)
  status           String   @default("queued")
  providerTaskId   String?
  providerResult   Json?
  attemptCount     Int      @default(0)
  pollFailures     Int      @default(0)
  saveAttempts     Int      @default(0)
  error            String?
  errorCode        String?
  nextRunAt        DateTime @default(now())
  leaseToken       String?
  leaseExpiresAt   DateTime?
  revision         Int      @default(0)
  creditCost       Int      @default(0)
  creditHoldId     String?
  submittedAt      DateTime?
  completedAt      DateTime?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@unique([taskId, index])
  @@index([status, nextRunAt, leaseExpiresAt])
  @@map("generation_task_items")
}

model CreditAccount {
  userId    String @id
  user      User @relation(fields: [userId], references: [id], onDelete: Restrict)
  available Int @default(0)
  frozen    Int @default(0)
  spent     Int @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@map("credit_accounts")
}

model CreditHold {
  id          String @id @default(uuid())
  userId      String
  user        User @relation(fields: [userId], references: [id], onDelete: Restrict)
  key         String @unique
  amount      Int
  status      String @default("held")
  reason      String
  referenceId String?
  expiresAt   DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  @@index([status, expiresAt])
  @@index([userId, createdAt])
  @@map("credit_holds")
}

model CreditEntry {
  id             String @id @default(uuid())
  userId         String
  user           User @relation(fields: [userId], references: [id], onDelete: Restrict)
  key            String @unique
  type           String
  amount         Int
  availableDelta Int
  frozenDelta    Int
  availableAfter Int
  frozenAfter    Int
  reason         String
  referenceId    String?
  actorId        String?
  createdAt      DateTime @default(now())
  @@index([userId, createdAt])
  @@index([referenceId])
  @@map("credit_entries")
}

model CreditPrice {
  id          String @id @default(uuid())
  kind        String
  model       String
  unit        String @default("request")
  credits     Int
  enabled     Boolean @default(true)
  version     Int @default(1)
  updatedAt   DateTime @updatedAt
  @@unique([kind, model])
  @@map("credit_prices")
}

model PlatformSetting {
  key   String @id
  value Int
  @@map("platform_settings")
}

model AdminAudit {
  id        String @id @default(uuid())
  actorId   String
  action    String
  targetId  String
  detail    Json
  createdAt DateTime @default(now())
  @@index([createdAt])
  @@map("admin_audits")
}

// 素材库文件夹；parentId 自关联支持嵌套，teamId 为团队归属预留列（团队表建立后再补外键）
model AssetFolder {
  id        String        @id @default(uuid())
  userId    String
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  parentId  String?
  parent    AssetFolder?  @relation("AssetFolderTree", fields: [parentId], references: [id], onDelete: Cascade)
  children  AssetFolder[] @relation("AssetFolderTree")
  teamId    String?
  name      String
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  assets Asset[]

  @@index([userId, createdAt])
  @@index([teamId, createdAt])
  @@map("asset_folders")
}

model RenderJob {
  id               String    @id @default(uuid())
  userId           String
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  projectId        String
  status           String
  stage            String    @default("queued")
  quality          String    @default("high")
  progress         Int       @default(0)
  attemptCount     Int       @default(0)
  maxAttempts      Int       @default(3)
  cancelRequested  Boolean   @default(false)
  checkpoint       String    @default("none")
  timelineSnapshot Json?
  checkpointData   Json?
  outputUrl        String?
  outputPath       String?
  fileName         String?
  error            String?
  errorDetail      String?
  failureCode      String?
  failureCategory  String?
  failureLevel     String?
  failureStage     String?
  retryable        Boolean   @default(false)
  startedAt        DateTime?
  nextRetryAt      DateTime?
  finishedAt       DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @default(now()) @updatedAt

  @@index([userId, createdAt])
  @@index([userId, projectId, createdAt])
  @@index([status, updatedAt])
  @@map("render_jobs")
}
