generator client {
  provider = "prisma-client-js"
  output   = "../generated/client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String?
  name         String
  avatarUrl    String?
  status       String   @default("active")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  projects     Project[]
  canvases     Canvas[]
  assets       Asset[]
  renderJobs   RenderJob[]
  assetFolders AssetFolder[]

  @@map("users")
}

model Canvas {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  graph     Json     @default("{\"version\":1,\"nodes\":[],\"edges\":[],\"viewport\":{\"x\":0,\"y\":0,\"zoom\":1}}")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  assets Asset[]

  @@index([userId, updatedAt])
  @@map("canvases")
}

model Project {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  timeline  Json
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  assets Asset[]

  @@index([userId, updatedAt])
  @@map("projects")
}

model Asset {
  id               String       @id @default(uuid())
  userId           String
  user             User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  projectId        String?
  project          Project?     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  canvasId         String?
  canvas           Canvas?      @relation(fields: [canvasId], references: [id], onDelete: Cascade)
  // 素材库归属：folderId 非空表示素材库素材（projectId/canvasId 为空）
  folderId         String?
  folder           AssetFolder? @relation(fields: [folderId], references: [id], onDelete: Cascade)
  kind             String
  source           String
  status           String
  name             String
  url              String?
  localPath        String?
  // kind=text 时的文本内容；媒体素材为空
  content          String?
  durationInFrames Int?
  width            Int?
  height           Int?
  prompt           String?
  createdAt        DateTime     @default(now())

  @@index([userId, projectId, createdAt])
  @@index([userId, canvasId, createdAt])
  @@index([userId, folderId, createdAt])
  @@map("assets")
}

// 素材库文件夹；parentId 自关联支持嵌套，teamId 为团队归属预留列（团队表建立后再补外键）
model AssetFolder {
  id        String        @id @default(uuid())
  userId    String
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  parentId  String?
  parent    AssetFolder?  @relation("AssetFolderTree", fields: [parentId], references: [id], onDelete: Cascade)
  children  AssetFolder[] @relation("AssetFolderTree")
  teamId    String?
  name      String
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  assets Asset[]

  @@index([userId, createdAt])
  @@index([teamId, createdAt])
  @@map("asset_folders")
}

model RenderJob {
  id               String    @id @default(uuid())
  userId           String
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  projectId        String
  status           String
  stage            String    @default("queued")
  quality          String    @default("high")
  progress         Int       @default(0)
  attemptCount     Int       @default(0)
  maxAttempts      Int       @default(3)
  cancelRequested  Boolean   @default(false)
  checkpoint       String    @default("none")
  timelineSnapshot Json?
  checkpointData   Json?
  outputUrl        String?
  outputPath       String?
  fileName         String?
  error            String?
  errorDetail      String?
  failureCode      String?
  failureCategory  String?
  failureLevel     String?
  failureStage     String?
  retryable        Boolean   @default(false)
  startedAt        DateTime?
  nextRetryAt      DateTime?
  finishedAt       DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @default(now()) @updatedAt

  @@index([userId, createdAt])
  @@index([userId, projectId, createdAt])
  @@index([status, updatedAt])
  @@map("render_jobs")
}
