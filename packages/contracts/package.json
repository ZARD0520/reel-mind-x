{
  "name": "@reel/contracts",
  "version": "0.0.0",
  "private": true,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./generation": {
      "types": "./src/generation.ts",
      "browser": "./src/generation.ts",
      "default": "./dist/generation.js"
    },
    "./sse": {
      "types": "./src/sse.ts",
      "browser": "./src/sse.ts",
      "default": "./dist/sse.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json --watch",
    "typecheck": "tsc --noEmit",
    "lint": "echo \"no lint configured\" "
  },
  "dependencies": {
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "typescript": "^5.7.3"
  }
}
